/* =========================================
   SCHOLARSHIP MONITORING SYSTEM
   LOGIN PAGE DESIGN
========================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #24213a;
}

/* =========================================
   LOGIN PAGE
========================================= */

.login-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;

    background:
        linear-gradient(
            135deg,
            #eef3fb 0%,
            #f7f5fc 50%,
            #e9eef8 100%
        );

    padding: 30px;
}


/* =========================================
   LOGIN CARD
========================================= */

.login-card {
    width: 100%;
    max-width: 500px;

    background: #ffffff;

    padding: 45px 50px;

    border-radius: 20px;

    box-shadow:
        0 15px 45px rgba(35, 30, 70, 0.12);

    text-align: center;
}


/* =========================================
   BRAND ICON
========================================= */

.brand-icon {
    width: 75px;
    height: 75px;

    margin: 0 auto 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #eef3fb;

    border-radius: 50%;

    font-size: 38px;

    box-shadow:
        0 5px 15px rgba(59, 103, 152, 0.12);
}


/* =========================================
   TITLE
========================================= */

.login-card h1 {
    color: #315d91;

    font-size: 36px;

    line-height: 1.2;

    margin-bottom: 12px;

    font-weight: 700;
}


/* =========================================
   SUBTITLE
========================================= */

.subtitle {
    color: #77748a;

    font-size: 16px;

    margin-bottom: 32px;

    line-height: 1.5;
}


/* =========================================
   FORM
========================================= */

#loginForm {
    text-align: left;
}


/* LABEL */

#loginForm label {
    display: block;

    color: #292348;

    font-size: 15px;

    font-weight: 700;

    margin-bottom: 8px;

    margin-top: 18px;
}


/* INPUT */

#loginForm input {
    width: 100%;

    height: 52px;

    padding: 0 16px;

    border: 1px solid #d6d6df;

    border-radius: 9px;

    background: #ffffff;

    color: #24213a;

    font-size: 16px;

    outline: none;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}


/* INPUT FOCUS */

#loginForm input:focus {
    border-color: #3b6798;

    box-shadow:
        0 0 0 3px rgba(59, 103, 152, 0.12);
}


/* PLACEHOLDER */

#loginForm input::placeholder {
    color: #a2a2ad;
}


/* =========================================
   BUTTON
========================================= */

.btn {
    width: 100%;

    height: 52px;

    border: none;

    border-radius: 9px;

    font-size: 17px;

    font-weight: 600;

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.15s ease,
        box-shadow 0.2s ease;
}


/* LOGIN BUTTON */

.btn.primary {
    margin-top: 28px;

    background: #3b6798;

    color: #ffffff;

    box-shadow:
        0 5px 12px rgba(59, 103, 152, 0.20);
}


.btn.primary:hover {
    background: #315d91;

    box-shadow:
        0 7px 16px rgba(59, 103, 152, 0.25);
}


.btn.primary:active {
    transform: translateY(1px);
}


/* =========================================
   MESSAGE
========================================= */

.message {
    min-height: 24px;

    margin-top: 12px;

    font-size: 14px;

    text-align: center;

    color: #c23b3b;
}


/* SUCCESS MESSAGE */

.message.success {
    color: #238448;
}


/* ERROR MESSAGE */

.message.error {
    color: #c23b3b;
}


/* =========================================
   DEMO LOGIN
========================================= */

.demo-login {
    margin-top: 22px;

    padding: 13px 15px;

    background: #f5f6fa;

    border: 1px solid #e4e5eb;

    border-radius: 8px;

    color: #666477;

    font-size: 13px;

    line-height: 1.6;
}


.demo-login b {
    color: #315d91;
}


/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 600px) {

    .login-page {
        padding: 20px;
    }

    .login-card {
        padding: 35px 25px;

        border-radius: 16px;
    }

    .login-card h1 {
        font-size: 28px;
    }

    .subtitle {
        font-size: 14px;
    }

    #loginForm input {
        height: 50px;
    }

    .btn {
        height: 50px;
    }

    .brand-icon {
        width: 65px;
        height: 65px;

        font-size: 32px;
    }
}


/* =========================================
   VERY SMALL SCREEN
========================================= */

@media (max-width: 380px) {

    .login-card {
        padding: 30px 20px;
    }

    .login-card h1 {
        font-size: 25px;
    }

}
